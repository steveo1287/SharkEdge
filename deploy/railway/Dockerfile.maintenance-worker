FROM node:20-bookworm-slim

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma
COPY scripts ./scripts
RUN npm ci --include=dev

COPY . .

ENV NODE_ENV=production
ENV SHARKEDGE_WORKER_MODE=disabled
ENV SHARKEDGE_DISABLE_WORKERS=true
ENV RAILWAY_WORKER_KIND=maintenance-worker

CMD ["npm", "run", "worker:railway:maintenance"]
