# SharkEdge Railway primary production env template.
# Copy values into Railway Variables. Do not commit real secrets.

# Required on every service.
NODE_ENV=production
DATABASE_URL=
DIRECT_URL=
CRON_SECRET=
INTERNAL_API_KEY=
INTERNAL_API_KEY2=
SHARKEDGE_ALLOW_DEGRADED_BOOT=true

# Web service.
SHARKEDGE_SERVICE_MODE=web
PORT=3000

# Public Railway web URL used by smoke checks.
SHARKEDGE_RAILWAY_URL=https://

# Private Railway web URL used by worker services.
# Replace sharkedge-web with the exact Railway web service name.
RAILWAY_WEB_INTERNAL_URL=http://sharkedge-web:3000

# Cache / Redis if enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MLB odds-api.io worker.
ODDSAPI_IO_KEY=
ODDS_API_IO_KEY=
ODDS_API_IO_EVENT_LIMIT=20
MLB_ODDS_REFRESH_INTERVAL_SECONDS=600
# UTC hours. Default maps to roughly 10am-1am Central during MLB season.
MLB_ODDS_ACTIVE_UTC_HOURS=0,1,2,3,4,5,6,15,16,17,18,19,20,21,22,23

# Sim snapshot worker.
SIM_REFRESH_INTERVAL_SECONDS=1800
SIM_MARKET_REFRESH_INTERVAL_SECONDS=600

# UFC worker.
UFC_ADMIN_RUN_TOKEN=
UFC_AUTOPILOT_INTERVAL_SECONDS=21600

# Maintenance worker.
DB_SPACE_REPAIR_INTERVAL_SECONDS=86400
SETTLE_SIM_INTERVAL_SECONDS=3600

# OddsHarvester Python worker if used.
SHARKEDGE_BACKEND_URL=http://sharkedge-web:3000
SHARKEDGE_API_KEY=
POST_TO_BACKEND=true
ODDSHARVESTER_HEADLESS=true
POLL_INTERVAL_SECONDS=900
ENABLED_SPORT_KEYS=baseball_mlb,mma_mixed_martial_arts
